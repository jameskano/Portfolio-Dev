---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>

  <body class="relative bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))]">
    <div
      class="absolute inset-0 z-[-2] min-h-screen w-full bg-[radial-gradient(ellipse_70%_70%_at_50%_-20%,rgba(34,211,238,0.18),rgba(255,255,255,0))]"
    >
    </div>
    <div class="gradient hidden sm:block" id="gradient"></div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: dark;
        --color-bg: 13 21 38;
        --color-surface: 15 23 42;
        --color-surface-muted: 30 41 59;
        --color-text: 226 232 240;
        --color-text-muted: 148 163 184;
        --color-border: 71 85 105;
        --color-accent: 34 211 238;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
        box-sizing: border-box;
        background-color: rgb(var(--color-bg));
      }

      .gradient {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0.8;
        background: radial-gradient(circle at center, rgba(var(--color-accent), 0.12), transparent 75%);
        transition: background-position 0.1s;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .gradient {
          display: none;
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(var(--color-border), 0.25);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgba(var(--color-surface), 0.72);
          border-radius: 9999px;
          box-shadow:
            0 12px 30px -22px rgba(15, 23, 42, 0.45),
            inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }
      }
    </style>

    <script>
      document.addEventListener("mousemove", function (event) {
        const gradient = document.getElementById("gradient") as HTMLDivElement | null
        if (!gradient) return

        const calculateSize = () => {
          const minSize = 400
          const maxSize = 600
          const size = Math.max(minSize, Math.min(window.innerWidth * 0.7, maxSize))
          return size === minSize ? window.innerWidth * 0.9 : size
        }

        const size = calculateSize()

        gradient.style.background = `radial-gradient(circle ${size}px at ${event.clientX}px ${event.clientY}px, rgba(var(--color-accent), 0.14), transparent 80%)`
      })
    </script>
  </body>
</html>
