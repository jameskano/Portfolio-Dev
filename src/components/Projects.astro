---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import LinkButtonAlt from "./LinkButtonAlt.astro"
import Tag from "./Tag.astro"

const PROJECTS = [
  {
    title: "Habit Compass",
    description:
      "A habit and task tracking app designed to help users stay consistent while keeping their daily actions connected to the areas and priorities that matter most to them. Built with a focus on simplicity, flexibility and thoughtful product design.",
    github: "https://github.com/jameskano/habit-compass",
    link: "",
    image: "https://lh3.googleusercontent.com/d/16r4Yq14Y0nszRLaTocuTRxmo06eVJ7CF=w1000?authuser=0",
    tags: ["TypeScript", "React", "SCSS", "Supabase", "PostgreSQL", "Mobile-first", "Responsive Design", "Monetization", "Accessibility"],
  },
  {
    title: "Tandem",
    description:
      "A couples activity planner that helps partners discover and organize ideas for spending meaningful time together. The project combines personalized suggestions, planning tools and a simple mobile-first experience.",
    github: "https://github.com/jameskano/tandem",
    link: "",
    image: "https://lh3.googleusercontent.com/d/1I2Ighm2ztx5cIxwjrfCEyGdVYlxVGYv_=w1000?authuser=0",
    tags: ["React", "SCSS", "TypeScript", "Supabase", "PostgreSQL", "Mobile-first", "Responsive Design", "Monetization", "Accessibility"],
  },
  {
    title: "Workout configurator",
    description:
      "A mobile-first workout planning app focused on building and organizing gym routines, with flows for creating exercises, structuring sessions, and keeping workout data easy to review and edit.",
    link: "",
    image: "https://drive.google.com/thumbnail?sz=w1000&id=1LUWhTKoS-I0GGGGDYO-kvf8L9psWtH6r",
    github: "https://github.com/jameskano/workout-configurator",
    tags: ["React", "SCSS", "Node.js", "Express", "MUI", "TypeScript", "MongoDB", "Mobile-first", "Responsive Design"],
  },
]
---

<div class="group/list flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="relative flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 p-6 hover:bg-slate-800/50 rounded-2xl transition-all duration-100 ease-in-out hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.2)]">
        <div class="w-full md:w-[40%]">
          <div class="relative col-span-6 row-span-5 overflow-clip rounded-xl border border-[rgba(var(--color-border),0.18)] shadow-lg shadow-slate-950/10">
            <img class="aspect-[16/10] w-full object-cover object-top" loading="lazy" src={image} alt={title} />
            <div class="absolute left-0 top-0 h-full w-full bg-[rgba(var(--color-accent),0.08)] transition-opacity duration-200 group-hover:opacity-0"></div>
          </div>
        </div>

        <div class="w-full">
          <h3 class="text-xl font-bold text-[rgb(var(--color-text))]">
            {title}
          </h3>
          <div class="mt-2 flex flex-wrap">
            <ul class="mb-2 flex flex-row flex-wrap gap-2">
              {tags.map((tag) => (
                <Tag>{tag}</Tag>
              ))}
            </ul>

            <div class="mt-2 text-slate-300">{description}</div>
            <footer class="mt-4 flex items-end justify-start gap-x-4">
              {github && (
                <LinkButtonAlt href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButtonAlt>
              )}
              {link && (
                <LinkButtonAlt href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButtonAlt>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
