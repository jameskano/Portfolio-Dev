---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
---

<button
  id="theme-toggle-btn"
  type="button"
  aria-label="Toggle theme"
  class="ml-1 inline-flex size-9 items-center justify-center rounded-full border border-[rgba(var(--color-border),0.28)] bg-[rgba(var(--color-surface),0.5)] text-[rgb(var(--color-text-muted))] transition-colors duration-200 hover:text-[rgb(var(--color-accent))] focus:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[rgb(var(--color-bg))]"
>
  <SunIcon id="theme-icon-light" class="size-4" />
  <MoonIcon id="theme-icon-dark" class="hidden size-4" />
</button>

<script is:inline>
  const themeToggle = document.getElementById("theme-toggle-btn")
  const lightIcon = document.getElementById("theme-icon-light")
  const darkIcon = document.getElementById("theme-icon-dark")

  const getThemePreference = () =>
    typeof localStorage !== "undefined"
      ? localStorage.getItem("theme") ?? "dark"
      : "dark"

  const syncTheme = () => {
    const isDark = getThemePreference() === "dark"

    document.documentElement.classList.toggle("dark", isDark)
    lightIcon?.classList.toggle("hidden", isDark)
    darkIcon?.classList.toggle("hidden", !isDark)
  }

  syncTheme()

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.classList.contains("dark")
      ? "light"
      : "dark"

    localStorage.setItem("theme", nextTheme)
    syncTheme()
  })
</script>
