---
const personalImageAlt = "Jaime Canovas"
import Badge from "@/components/Badge.astro"
---

<div class="max-w-xl">
  <div class="mb-4 flex items-center gap-4">
    <img
      class="size-16 rounded-full shadow-lg"
      src="/avatar.webp"
      alt={personalImageAlt}
    />
    <div
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Available to work</Badge>
    </div>
  </div>
  <h1
    class="text-3xl font-bold tracking-tight text-[rgb(var(--color-text))] sm:text-4xl"
  >
    Hey, I'm Jaime Canovas!
  </h1>
  <p
    class="mt-4 text-2xl text-[rgb(var(--color-text-muted))] [&>strong]:font-semibold [&>strong]:text-[rgb(var(--color-accent))]"
  >
    <strong>Software Engineer</strong>
  </p>
  <p class="mt-2 text-xl text-slate-300">Specialized in the development of unique applications.</p>
</div>
