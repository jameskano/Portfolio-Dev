---
import LinkInline from "./LinkInline.astro"
import Tag from "./Tag.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
  tags: string[]
  client?: string
  project?: string
  highlights?: string[]
}

const { title, company, description, link, date, tags, client, project, highlights = [] } = Astro.props
---

<div
  class="relative mx-12 grid pb-12 before:absolute before:left-[-28px] before:block before:h-full before:border-l-2 before:border-[rgba(var(--color-border),0.18)] before:content-[''] md:grid-cols-5 md:gap-10 md:before:left-[-36px]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="absolute -left-[36px] rounded-full text-5xl text-[rgb(var(--color-accent))] md:-left-[44px]"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-[rgb(var(--color-accent))]">{title}</h3>
      <h4 class="text-lg font-semibold text-[rgb(var(--color-text))]">{company}</h4>
      {client && <p class="mt-2 text-sm font-medium text-[rgb(var(--color-text))]">Client: {client}</p>}
      {project && <p class="text-sm text-[rgb(var(--color-text-muted))]">Project: {project}</p>}
      <time class="mt-2 block p-0 text-sm text-[rgb(var(--color-text-muted))]">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-4 pb-4 text-slate-300 md:col-span-3">
    <p>{description}</p>
    {
      highlights.length > 0 && (
        <ul class="space-y-2 text-[rgb(var(--color-text-muted))]">
          {highlights.map((item) => (
            <li class="flex gap-2">
              <span class="text-[rgb(var(--color-accent))]">&gt;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )
    }
    <ul class="mb-2 flex flex-row flex-wrap gap-2">
      {tags.map((tag) => (
        <Tag>{tag}</Tag>
      ))}
    </ul>
    {
      link && (
        <LinkInline href={link}>
          Learn more{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-chevron-right w-5"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
